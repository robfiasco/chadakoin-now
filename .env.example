# Apple WeatherKit (api/weather.js) — requires a paid Apple Developer account.
# Create a WeatherKit key in developer.apple.com, then base64-encode the .p8 file:
#   base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
WEATHERKIT_PRIVATE_KEY=

# EIA gas prices (api/gas.js) — free key at eia.gov/opendata
EIA_API_KEY=

# Resend transactional email (api/feedback.js) — for the in-app feedback form
RESEND_API_KEY=
